<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude user preferences containing API credentials and local databases from unencrypted cloud backup -->
        <exclude domain="sharedpref" path="user_preferences.preferences_pb" />
        <exclude domain="database" path="studymate_db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="user_preferences.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
